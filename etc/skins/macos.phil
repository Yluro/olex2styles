# Generated by etc/styles/build_modern.py - edit the palette there.
# macOS add-on for every olex2styles skin. Load it as the skin's extension, for
# example "skin modern_macos" or "skin moderndarkblue_macos". It sets the taller
# controls of Olex2's mac skin, the Mac system font for panel text, and
# Trebuchet MS for the drawn images through Olex2's free Optane font slot. Run
# macos/install-trebuchet.sh once to fill that slot, otherwise Olex2 uses Vera.
gui {
  htmlpanelwidth = 560
  image_font_name = Optane
  skin {
    icon_size = 32
  }
  html {
    font_name = DefaultFont
    input_height = 24
    checkbox_height = 24
    combo_height = 24
    spin_height = 24
    checkbox_width = 20
    combo_width_2 = 55
    font_size = 3
    font_size_controls = 4
  }
  timage {
    font_name = Optane
    snumtitle {
      font_name = Optane Bold
    }
    tab {
      font_name = Optane Bold
      height = 32
    }
    cbtn {
      font_name = Optane Bold
      height = 24
    }
    button {
      font_name = Optane
      height = 22
      top = 3
    }
    h1 {
      font_name = Optane
      height = 26
      font_size = 16
      top = 4
      left = 10
    }
    h3 {
      font_name = Optane
      height = 19
      top = 1
      left = 8
    }
    tinybutton {
      font_name = Optane
      height = 26
      width = 30
      font_size = 18
    }
  }
}
